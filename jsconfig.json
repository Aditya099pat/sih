{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./frontend/src/*"],
      "@data/*": ["./data/*"],
      "@backend/*": ["./backend/*"]
    }
  },
  "include": [
    "frontend/src/**/*",
    "backend/**/*",
    "data/**/*",
    "vite.config.js"
  ],
  "exclude": ["node_modules", "dist"]
}
